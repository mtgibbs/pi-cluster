# build-codex — the same build loop, driven by Codex instead of qwen.
# Loop Library: Generate-Verify-Refine, identical to build-converge; only the executor binding
# differs. That this file is four lines rather than a second loop script is the whole point of
# specs/executor-binding.
STRATEGY_DESC="Codex builds task-by-task until the deterministic gate is green"
STRATEGY_PHASES="build"
# Name the executor in the evidence. With one build loop, RALPH_AGENT no longer follows from
# which script was invoked, so a Codex run would otherwise be filed as `qwen-<pid>` — the
# index would show the wrong family for every attempt.
export RALPH_AGENT="${RALPH_AGENT:-codex}"
export RALPH_EXEC_CMD="${RALPH_EXEC_CMD:-${SCRIPT_DIR:-scripts}/exec-codex.sh}"
# Codesheet off: its measured 20-56% context saving came from a 30B with a small window
# (docs/research/codemap-serena-token-efficiency.md). Codex has its own repo navigation and
# prompt cache, so the win is UNMEASURED for it — RALPH_SHEET=on to A/B, don't assume it transfers.
export RALPH_SHEET="${RALPH_SHEET:-off}"
