# judge-refine — post-convergence quality pass on an ALREADY-green gate.
# Loop Library: Evaluator/Judge, cross-family for real independence.
# Preflight in ralph-judge.sh enforces the clean-tree/green-gate contract.
STRATEGY_DESC="Codex judges intent, qwen applies one finding per round, gate arbitrates"
STRATEGY_PHASES="judge"
export JUDGE_CMD="${JUDGE_CMD:-${SCRIPT_DIR:-scripts}/ralph-judge-codex.sh}"
export EXECUTOR_CMD="${EXECUTOR_CMD:-${SCRIPT_DIR:-scripts}/ralph-judge-exec-qwen.sh}"
export MAX_ROUNDS="${MAX_ROUNDS:-5}"
